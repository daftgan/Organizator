# Revizator serveur : copier en deploy/.env (cp .env.example .env), ou coller dans l'onglet
# « Environment » de la stack Komodo. Ne jamais versionner le .env : il contient le jeton de Claude Code.

# Adresse publique (lien d'appairage et QR code de « revizator-server token new »).
REVIZATOR_PUBLIC_URL=https://revizator.daft-lab.fr

# Origines autorisees en CORS : la page d'Organizator dans WebView2 (inutile de changer).
REVIZATOR_ALLOWED_ORIGINS=https://app.organizator

# Adresses dont le serveur croit X-Forwarded-For / X-Forwarded-Proto (le reverse proxy NPM). « private »
# (defaut) : tout le reseau prive, donc aussi un appareil du LAN qui parlerait directement au port 8080.
# Plus strict : l'adresse de NPM (192.168.1.11), une fois verifie dans « docker logs revizator » que
# « Appareil appaire : … (<IP>) » montre bien l'adresse publique du telephone (voir README, § 6).
REVIZATOR_TRUSTED_PROXIES=private

# Jeton de « claude setup-token » (abonnement Claude, valable un an). Sans lui, les generations echouent.
CLAUDE_CODE_OAUTH_TOKEN=

# Version de Claude Code installee dans l'image : stable, latest ou un numero precis.
REVIZATOR_CLAUDE_VERSION=stable

TZ=Europe/Paris
